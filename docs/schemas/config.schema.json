{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thincoder.dev/schemas/config.json",
  "title": "ThinCoder Configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "description": "JSON Schema reference (auto-injected on save)" },
    "providers": {
      "type": "array",
      "description": "LLM provider list",
      "items": {
        "type": "object",
        "required": ["name", "baseURL", "model"],
        "properties": {
          "name": { "type": "string", "description": "Provider name (e.g. deepseek, kimi)" },
          "baseURL": { "type": "string", "format": "uri", "description": "OpenAI-compatible base URL" },
          "apiKey": { "type": "string", "description": "API key (falls back to env vars if empty)" },
          "model": { "type": "string", "description": "Default model for this provider" },
          "thinking": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "properties": { "type": { "type": "string", "enum": ["enabled", "adaptive"] } } }
            ],
            "description": "Thinking mode config (null = disabled)"
          },
          "reasoningEffort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max", "none", "minimal"], "description": "Reasoning effort level" },
          "maxTokens": { "type": "integer", "minimum": 1, "description": "Max output tokens" },
          "tpm": { "type": "integer", "minimum": 1, "description": "Tokens per minute rate limit" },
          "rpm": { "type": "integer", "minimum": 1, "description": "Requests per minute rate limit" }
        }
      }
    },
    "activeProvider": { "type": "string", "description": "Currently active provider name" },
    "agent": {
      "type": "object",
      "properties": {
        "maxTurns": { "type": "integer", "default": 100, "minimum": 1 },
        "subagentTurns": { "type": "integer", "default": 100, "minimum": 1 },
        "goalTurns": { "type": "integer", "default": 200, "minimum": 1 },
        "compactThreshold": { "type": "integer", "description": "Context compaction threshold (tokens). Set to override auto-detection." },
        "verifyGuard": { "type": "boolean", "default": false, "description": "Push model to verify mutated files before completion" },
        "streamRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "message"],
            "properties": {
              "pattern": { "type": "string", "description": "JS regex pattern" },
              "message": { "type": "string", "description": "Reminder message when triggered" },
              "action": { "type": "string", "enum": ["abort", "warn"], "default": "abort" },
              "repeat": { "type": "string", "enum": ["always", "once"], "default": "always" }
            }
          }
        },
        "advisor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "provider": { "type": "string", "description": "Override provider for advisor" },
            "model": { "type": "string", "description": "Override model for advisor" }
          }
        },
        "autoThink": { "type": "boolean", "default": false, "description": "Auto-classify task difficulty per turn" }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "dbPath": { "type": "string", "description": "SQLite index path" },
        "projectDir": { "type": "string", "default": ".thincoder/memory" },
        "team": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "repo"],
              "properties": {
                "name": { "type": "string" },
                "repo": { "type": "string", "format": "uri" }
              }
            }
          ]
        }
      }
    },
    "embedding": {
      "type": "object",
      "properties": {
        "baseURL": { "type": "string", "format": "uri", "default": "https://api.siliconflow.cn/v1" },
        "apiKey": { "type": "string", "description": "Embedding API key (falls back to SILICONFLOW_API_KEY)" },
        "model": { "type": "string", "default": "BAAI/bge-m3" }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "command"],
            "properties": {
              "name": { "type": "string" },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "PreToolUse": { "$ref": "#/$defs/hookList" },
        "PostToolUse": { "$ref": "#/$defs/hookList" },
        "PostToolUseFailure": { "$ref": "#/$defs/hookList" },
        "Notification": { "$ref": "#/$defs/hookList" }
      }
    }
  },
  "$defs": {
    "hookList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "matcher": { "type": "string", "description": "Regex against tool name" },
          "command": { "type": "string", "description": "Executable path or name" },
          "args": { "type": "array", "items": { "type": "string" }, "description": "CLI args (optional; without args, stdin receives JSON)" },
          "timeout": { "type": "integer", "default": 10000, "minimum": 100, "description": "Timeout in ms" },
          "action": { "type": "string", "enum": ["allow", "block", "notify"], "default": "notify" }
        }
      }
    }
  }
}
